<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>SkyDispatch</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default"><line choice="com.skydispatch.app"/></line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.skydispatch.app" visible="false"><pkg-ref id="com.skydispatch.app"/></choice>
    <pkg-ref id="com.skydispatch.app" auth="Root">SkyDispatch-component.pkg</pkg-ref>
</installer-gui-script>
